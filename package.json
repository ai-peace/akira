    "lucide-react": "^0.468.0",
    "next": "14.2.5",
    "next-themes": "^0.4.6",
    "path": "^0.12.7",
    "playwright": "^1.51.1",
    "postcss": "^8.4.49",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "^7.54.2",
    "sonner": "^2.0.2",
    "swr": "^2.3.2",
