{
  "name": "akira-v2",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate --schema=./server/prisma/schema.prisma && next build",
    "start": "next start",
    "lint": "next lint",
    "migrate:generate": "prisma migrate dev --schema=./server/prisma/schema.prisma --create-only --name",
    "migrate:deploy": "prisma migrate deploy --schema=./server/prisma/schema.prisma",
    "migrate:deploy:test": "prisma migrate deploy --schema=./server/prisma/schema.test.prisma",
    "db:push": "prisma db push --schema=./server/prisma/schema.prisma",
    "db:push:test": "prisma db push --schema=./server/prisma/schema.test.prisma",
    "db:reset": "prisma migrate reset --schema=./server/prisma/schema.prisma",
    "db:reset:test": "prisma migrate reset --schema=./prisma/schema.test.prisma",
    "prisma:generate": "prisma generate --schema=./server/prisma/schema.prisma",
    "mastra:dev": "mastra dev -d server/mastra"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.3",
    "@faker-js/faker": "^9.6.0",
    "@hono/zod-validator": "^0.4.3",
